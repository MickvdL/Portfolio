<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Projects — Mick van der Linden</title>
</head>
<body>

    <%- include('partials/nav') %>

    <!-- ===== Hero ===== -->
    <section class="projects-hero">
        <div class="projects-hero-inner">
            <p class="projects-hero-label">Projects</p>
            <h1 class="projects-hero-title">During my studies and personal work, I have worked on several digital and branding projects. Most of these projects focused on creating visual identities, improving online communication, and designing content for different audiences. I enjoy combining creativity with strategy to make brands look more professional and recognizable.</h1>
        </div>
    </section>

    <!-- ===== Projects ===== -->
    <section class="projects-section">
        <h2 class="projects-heading">Projects</h2>
        <div class="projects-grid">
            <% projects.forEach(function(project, index) { %>
            <a href="/projects/<%= project.slug %>" class="project-card<%= index >= 4 ? ' project-card--hidden' : '' %>">
                <div class="project-image-wrap">
                    <img
                        src="<%= project.image %>"
                        alt="<%= project.title %>"
                        loading="lazy"
                    />
                    <div class="project-overlay">
                        <span class="project-overlay-label"><%= project.title %></span>
                    </div>
                </div>
                <p class="project-title"><%= project.title %></p>
            </a>
            <% }) %>
        </div>

        <% if (projects.length > 4) { %>
        <div class="load-more-wrap" id="loadMoreWrap">
            <button class="btn-load-more" id="loadMoreBtn">Load more</button>
            <button class="btn-load-more btn-show-less" id="showLessBtn" style="display:none;">Show less</button>
        </div>
        <% } %>
    </section>

    <!-- ===== Footer ===== -->
    <%- include('partials/footer') %>

    <script>
        const loadMoreBtn = document.getElementById('loadMoreBtn');
        const showLessBtn = document.getElementById('showLessBtn');
        const hiddenCards = document.querySelectorAll('.project-card--hidden');

        if (loadMoreBtn) {
            loadMoreBtn.addEventListener('click', function () {
                hiddenCards.forEach(function (card) {
                    card.classList.remove('project-card--hidden');
                });
                loadMoreBtn.style.display = 'none';
                showLessBtn.style.display = '';
            });
        }

        if (showLessBtn) {
            showLessBtn.addEventListener('click', function () {
                hiddenCards.forEach(function (card) {
                    card.classList.add('project-card--hidden');
                });
                showLessBtn.style.display = 'none';
                loadMoreBtn.style.display = '';
            });
        }
    </script>

</body>
</html>
