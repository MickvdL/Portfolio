<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>About — Mick van der Linden</title>
</head>
<body>

    <%- include('partials/nav') %>

    <!-- ===== About Hero ===== -->
    <section class="about-hero">
        <div class="about-hero-inner">

            <div class="about-intro">
                <p class="about-label">About</p>
                <h1 class="about-text">
                    Hi, I'm Mick. A visual designer that wants to make beautiful yet functional things.
                    Digital things. Like websites, visual identities, apps and other experiences for brands.
                </h1>
            </div>

            <!-- Skillset -->
            <div class="skillset">
                <h2 class="skillset-title">My skillset</h2>
                <div class="skillset-tags" id="skillsetTags">

                    <button class="skill-tag" data-category="development" data-key="css">
                        <img src="/assets/icons/tools/css.svg" alt="" aria-hidden="true">
                        CSS
                    </button>
                    <button class="skill-tag" data-category="development" data-key="html">
                        <img src="/assets/icons/tools/html.svg" alt="" aria-hidden="true">
                        HTML
                    </button>
                    <button class="skill-tag" data-category="workflow" data-key="claude">
                        <img src="/assets/icons/tools/claude-color.svg" alt="" aria-hidden="true">
                        Claude
                    </button>
                    <button class="skill-tag" data-category="workflow" data-key="firefly">
                        <img src="/assets/icons/tools/firelfy.png" alt="" aria-hidden="true">
                        Firefly
                    </button>
                    <button class="skill-tag" data-category="design" data-key="blender">
                        <img src="/assets/icons/tools/blender-icon.svg" alt="" aria-hidden="true">
                        Blender
                    </button>

                    <button class="skill-tag" data-category="design" data-key="figma">
                        <img src="/assets/icons/tools/Figma.svg" alt="" aria-hidden="true">
                        Figma
                    </button>
                    <button class="skill-tag" data-category="development" data-key="javascript">
                        <img src="/assets/icons/tools/js.svg" alt="" aria-hidden="true">
                        Javascript
                    </button>
                    <button class="skill-tag" data-category="design" data-key="photoshop">
                        <img src="/assets/icons/tools/Photoshop.svg" alt="" aria-hidden="true">
                        Photoshop
                    </button>
                    <button class="skill-tag" data-category="workflow" data-key="miro">
                        <img src="/assets/icons/tools/Miro.svg" alt="" aria-hidden="true">
                        Miro
                    </button>
                    <button class="skill-tag" data-category="design" data-key="illustrator">
                        <img src="/assets/icons/tools/Illustrator.svg" alt="" aria-hidden="true">
                        Illustrator
                    </button>

                    <button class="skill-tag" data-category="design" data-key="indesign">
                        <img src="/assets/icons/tools/InDesign.svg" alt="" aria-hidden="true">
                        Indesign
                    </button>
                    <button class="skill-tag" data-category="design" data-key="premiere">
                        <img src="/assets/icons/tools/Premiere Pro.svg" alt="" aria-hidden="true">
                        Premiere Pro
                    </button>
                    <button class="skill-tag" data-category="workflow" data-key="chatgpt">
                        <img src="/assets/icons/tools/openai.svg" alt="" aria-hidden="true">
                        ChatGPT
                    </button>
                    <button class="skill-tag" data-category="development" data-key="wordpress">
                        <img src="/assets/icons/tools/wordpress.png" alt="" aria-hidden="true">
                        Wordpress
                    </button>

                </div>

            </div>

        </div>
    </section>

    <!-- ===== Personal / Experiences ===== -->
    <section class="about-personal">
        <div class="about-personal-inner">

            <!-- Photo -->
            <div class="about-photo">
                <img src="/assets/images/mickphoto.JPG" alt="Mick van der Linden">
            </div>

            <!-- Experiences -->
            <div class="experiences">

                <div class="experiences-header">
                    <h2 class="experiences-title">Experiences</h2>
                    <span class="exp-years-badge">2+ years</span>
                </div>

                <!-- TD -->
                <div class="exp-item">
                    <div class="exp-company-head">
                        <img
                            class="exp-logo"
                            src="/assets/icons/general/companies/tdlogo.svg"
                            alt="Total Design"
                        >
                        <a class="exp-link" href="https://totaldesign.nl" target="_blank" rel="noopener">
                            <span>Total Design</span>
                            <img
                                class="exp-link-arrow"
                                src="/assets/icons/general/Arrow.svg"
                                alt=""
                                aria-hidden="true"
                            >
                        </a>
                    </div>
                    <div class="exp-roles">
                        <div class="exp-role">
                            <p class="role-title">Junior Designer</p>
                            <p class="role-period">2025 september – present, Amsterdam</p>
                        </div>
                        <div class="exp-role">
                            <p class="role-title">Junior Designer (intern)</p>
                            <p class="role-period">2025 april – 2025 july, Amsterdam</p>
                        </div>
                    </div>
                </div>

                <!-- Idiotes -->
                <div class="exp-item">
                    <div class="exp-company-head">
                        <img
                            class="exp-logo exp-logo--idiotes"
                            src="/assets/icons/general/companies/idiotes.png"
                            alt="Studio Idiotes"
                        >
                        <a class="exp-link" href="https://studioidiotes.nl" target="_blank" rel="noopener">
                            <span>Studio Idiotes</span>
                            <img
                                class="exp-link-arrow"
                                src="/assets/icons/general/Arrow.svg"
                                alt=""
                                aria-hidden="true"
                            >
                        </a>
                    </div>
                    <div class="exp-roles">
                        <div class="exp-role">
                            <p class="role-title">Graphic Designer</p>
                            <p class="role-period">2022 july – 2023 september, Castricum</p>
                        </div>
                        <div class="exp-role">
                            <p class="role-title">Graphic Designer (intern)</p>
                            <p class="role-period">2021 september – 2022 july, Castricum</p>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>

    <%- include('partials/footer') %>

    <script>
    // ===== Skillset tag interaction =====

    const CATEGORY_CURSORS = {
        development: '/assets/icons/general/Cursor pink.svg',
        design:      '/assets/icons/general/Cursor purple.svg',
        workflow:    '/assets/icons/general/Cursor orange.svg'
    };

    const CATEGORY_COLORS = {
        development: '#FF3366',
        design:      '#923AFF',
        workflow:    '#FF6A00'
    };

    const CATEGORY_LABELS = {
        development: 'Development',
        design:      'Design',
        workflow:    'Workflow'
    };

    const tagsContainer = document.getElementById('skillsetTags');
    const allTags       = document.querySelectorAll('.skill-tag');
    const isTouch       = window.matchMedia('(hover: none)').matches;

    let activeCategory  = null;
    let activeBadgeTag  = null;
    let clickLocked     = false;

    // ── Desktop: floating cursor that follows the mouse ──
    let floatingCursor, floatingIcon, floatingLabel;

    if (!isTouch) {
        floatingCursor = document.createElement('div');
        floatingCursor.className = 'floating-cursor';
        floatingCursor.setAttribute('aria-hidden', 'true');
        floatingCursor.innerHTML =
            '<img class="floating-cursor__icon" src="" alt="">' +
            '<span class="floating-cursor__label"></span>';
        document.body.appendChild(floatingCursor);

        floatingIcon  = floatingCursor.querySelector('.floating-cursor__icon');
        floatingLabel = floatingCursor.querySelector('.floating-cursor__label');

        document.addEventListener('mousemove', (e) => {
            if (!floatingCursor.classList.contains('floating-cursor--visible')) return;
            floatingCursor.style.left = e.clientX + 'px';
            floatingCursor.style.top  = e.clientY + 'px';
        });
    }

    // ── Mobile/tablet: fixed-position badge anchored to the tag's right edge ──
    const badge = document.createElement('span');
    badge.className = 'tag-cursor-badge';
    badge.setAttribute('aria-hidden', 'true');
    badge.innerHTML =
        '<img class="tag-cursor-badge__icon" src="" alt="">' +
        '<span class="tag-cursor-badge__label"></span>';
    document.body.appendChild(badge);

    const badgeIcon  = badge.querySelector('.tag-cursor-badge__icon');
    const badgeLabel = badge.querySelector('.tag-cursor-badge__label');

    function showBadgeOn(tag) {
        const category = tag.dataset.category;
        badgeIcon.src               = CATEGORY_CURSORS[category];
        badgeLabel.textContent      = CATEGORY_LABELS[category];
        badgeLabel.style.background = CATEGORY_COLORS[category];
        // Anchor ON the tag — cursor overlaps the right edge
        const rect = tag.getBoundingClientRect();
        badge.style.left    = (rect.right - 10) + 'px';
        badge.style.top     = (rect.top + rect.height / 2) + 'px';
        badge.style.display = 'flex';
        activeBadgeTag = tag;
    }

    function removeBadge() {
        badge.style.display = 'none';
        activeBadgeTag = null;
    }

    function highlightCategory(category) {
        allTags.forEach(t => {
            if (t.dataset.category === category) {
                t.classList.remove('skill-tag--dim');
                t.classList.add('skill-tag--selected');
            } else {
                t.classList.remove('skill-tag--selected');
                t.classList.add('skill-tag--dim');
            }
        });
        activeCategory = category;
    }

    function showDesktopCursor(category) {
        floatingIcon.src               = CATEGORY_CURSORS[category];
        floatingLabel.textContent      = CATEGORY_LABELS[category];
        floatingLabel.style.background = CATEGORY_COLORS[category];
        floatingCursor.classList.add('floating-cursor--visible');
        tagsContainer.classList.add('hide-cursor');
    }

    function hideDesktopCursor() {
        floatingCursor.classList.remove('floating-cursor--visible');
        tagsContainer.classList.remove('hide-cursor');
    }

    function resetTags() {
        allTags.forEach(t => t.classList.remove('skill-tag--dim', 'skill-tag--selected'));
        if (!isTouch) hideDesktopCursor();
        removeBadge();
        activeCategory = null;
        clickLocked    = false;
    }

    allTags.forEach(tag => {

        if (!isTouch) {
            // ── Desktop: hover shows/hides floating cursor ──
            tag.addEventListener('mouseenter', () => {
                highlightCategory(tag.dataset.category);
                showDesktopCursor(tag.dataset.category);
            });

            tag.addEventListener('mouseleave', (e) => {
                const next = e.relatedTarget;
                const movingToTag = next && (next.classList.contains('skill-tag') || next.closest('.skill-tag'));
                if (!movingToTag) {
                    if (!clickLocked) resetTags();
                    else hideDesktopCursor();
                }
            });

            // Desktop click — lock/unlock
            tag.addEventListener('click', () => {
                if (clickLocked && activeCategory === tag.dataset.category) {
                    resetTags();
                } else {
                    clickLocked = true;
                    highlightCategory(tag.dataset.category);
                    showDesktopCursor(tag.dataset.category);
                }
            });

        } else {
            // ── Mobile / tablet: click shows badge on tag ──
            tag.addEventListener('click', () => {
                if (clickLocked && activeBadgeTag === tag) {
                    resetTags();
                } else {
                    clickLocked = true;
                    highlightCategory(tag.dataset.category);
                    showBadgeOn(tag);
                }
            });
        }
    });

    // Re-show floating cursor when re-entering tags area while click-locked (desktop)
    if (!isTouch) {
        tagsContainer.addEventListener('mouseenter', () => {
            if (clickLocked && activeCategory) showDesktopCursor(activeCategory);
        });
        tagsContainer.addEventListener('mouseleave', () => {
            hideDesktopCursor();
        });
    }

    // Click outside → reset
    document.addEventListener('click', (e) => {
        if (!tagsContainer.contains(e.target) && !badge.contains(e.target)) resetTags();
    });
    </script>

</body>
</html>
